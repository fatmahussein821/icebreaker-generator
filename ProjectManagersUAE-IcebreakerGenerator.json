    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.links }}",
        "messages": {
          "messageValues": [
            {
              "message": "=We build a lead generation automated pipeline. We have extracted some links from a lead's website. \n\nYou role is to read the links and choose links that may contain important information about the company.(e.g. news, services, leadership).\n\nDON'T try to visit these website. Only from its domain, choose the best three links.\n\n##OUTPUT\nJSON\n\n{\n\"links\":\n[\n\"link1\", \"link2\", \"link3\"\n]\n}"
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        720,
        176
      ],
      "id": "ffcfe8a4-aafb-4af6-9ccf-54161fbd7c6a",
      "name": "Select URL",
      "retryOnFail": false
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nlet companyWebsite = '';\n\ntry {\n  companyWebsite =\n    $('Format Lead Data').first().json.Website ||\n    $('Format Lead Data').first().json.website ||\n    '';\n} catch {\n  companyWebsite = '';\n}\n\nfunction normalizeBaseUrl(value) {\n  if (!value || typeof value !== 'string') {\n    return '';\n  }\n\n  let url = value.trim();\n\n  if (!/^https?:\\/\\//i.test(url )) {\n    url = `https://${url}`;\n  }\n\n  try {\n    return new URL(url ).origin;\n  } catch {\n    return '';\n  }\n}\n\nlet baseUrl = normalizeBaseUrl(companyWebsite);\n\nlet response =\n  input.response?.generations?.[0]?.[0]?.text ??\n  input.text ??\n  input.output ??\n  input.message ??\n  '';\n\nif (typeof response !== 'string') {\n  response = JSON.stringify(response);\n}\n\nlet links = [];\n\ntry {\n  const cleanedResponse = response\n    .replace(/```json/gi, '')\n    .replace(/```/g, '')\n    .trim();\n\n  const jsonMatch = cleanedResponse.match(/\\{[\\s\\S]*\\}/);\n\n  if (jsonMatch) {\n    const parsed = JSON.parse(jsonMatch[0]);\n    links = parsed.links ?? parsed.Links ?? [];\n  }\n} catch {\n  links = [];\n}\n\nif (!Array.isArray(links) || links.length === 0) {\n  links = response.match(/https?:\\/\\/[^\\s\"'<>]+/gi ) || [];\n}\n\nif (!baseUrl) {\n  const firstFullLink = links.find((link) =>\n    /^https?:\\/\\//i.test(String(link ))\n  );\n\n  if (firstFullLink) {\n    try {\n      baseUrl = new URL(firstFullLink).origin;\n    } catch {\n      baseUrl = '';\n    }\n  }\n}\n\nconst normalizedLinks = [\n  ...new Set(\n    links\n      .map((link) => String(link).trim())\n      .map((link) => link.replace(/[.,;:!?)}\\]]+$/, ''))\n      .map((link) => {\n        if (link.startsWith('/')) {\n          return baseUrl ? `${baseUrl}${link}` : link;\n        }\n\n        if (!/^https?:\\/\\//i.test(link )) {\n          return `https://${link}`;\n        }\n\n        return link;\n      } )\n      .filter((link) => {\n        try {\n          const url = new URL(link);\n\n          return (\n            url.protocol === 'http:' ||\n            url.protocol === 'https:'\n           );\n        } catch {\n          return false;\n        }\n      })\n  )\n].slice(0, 3);\n\nreturn [\n  {\n    json: {\n      links: normalizedLinks,\n      link1: normalizedLinks[0] ?? null,\n      link2: normalizedLinks[1] ?? null,\n      link3: normalizedLinks[2] ?? null,\n      count: normalizedLinks.length,\n      baseUrl\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1056,
        160
      ],
      "id": "eb78b76d-9593-46ee-98cb-7cd5085e3301",
      "name": "Normalize Selected Links"
    },
    {
      "parameters": {
        "url": "={{ $json.links }}",
        "options": {}
